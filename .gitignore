# ─────────────────────────────────────────────────────────────
# Publish-list: git ignores EVERYTHING by default, then re-includes
# only the real live-app files below. This means deploy.bat can
# never accidentally publish the planning docs, the aiAssist draft,
# backups, or other local-only files.
# To publish a NEW file later, add a matching "!/filename" line.
# ─────────────────────────────────────────────────────────────
/*

!/.gitignore
!/index.html
!/privacy.html
!/terms.html
!/share.html
!/manifest.json
!/CNAME
!/README.md
!/CHANGELOG.md
!/sw.js
!/icon-32.png
!/icon-180.png
!/icon-192.png
!/icon-512.png
!/icon-maskable-512.png
!/firebase-messaging-sw.js
!/mining-catalog.json
!/story/
!/media/
!/.nojekyll
!/.well-known/
!/app/

# !/app/ re-includes the whole app folder, which also swept up the
# index.html.before.* safety copies. Later rules win, so re-ignore them.
/app/*.before*
/app/*.bak
/app/*.orig
!/welcome/
